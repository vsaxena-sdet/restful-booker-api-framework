<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.automation</groupId>
    <artifactId>restful-booker-api-framework</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Restful Booker API Automation Framework</name>
    <description>
        REST Assured + TestNG backend API automation framework exercising the
        open-source Restful-Booker demo API (https://restful-booker.herokuapp.com).
    </description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <rest-assured.version>5.5.0</rest-assured.version>
        <testng.version>7.10.2</testng.version>
        <jackson.version>2.17.2</jackson.version>
        <lombok.version>1.18.48</lombok.version>
        <slf4j.version>2.0.16</slf4j.version>

        <!-- Allure 3 — Java adapter + Maven plugin + npm CLI report version -->
        <allure.version>3.1.1</allure.version>
        <allure.report.version>3.33.0</allure.report.version>
        <allure.maven.version>3.1.0</allure.maven.version>

        <maven.surefire.plugin.version>3.5.6</maven.surefire.plugin.version>
        <maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
    </properties>

    <dependencies>
        <!-- REST Assured for API requests/assertions -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
        </dependency>

        <!-- TestNG as the test runner -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- Jackson for POJO (de)serialization, used internally by REST Assured -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Lombok to reduce POJO boilerplate -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Simple console logging binding for slf4j (used by rest-assured/testng transitively) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- Allure 3 TestNG adapter. Writes target/allure-results during the suite.
             Allure 3 uses Java SPI (ServiceLoader) instead of an AspectJ agent,
             so no aspectjweaver dependency or javaagent argLine is needed. -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                    <!-- No javaagent needed with Allure 3 — results dir is set
                         via allure.properties in src/test/resources. -->
                    <systemPropertyVariables>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- allure-maven 3: downloads Node.js + installs the allure npm package
                 at reportVersion and generates the Allure 3 HTML report. -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure.maven.version}</version>
                <configuration>
                    <reportVersion>${allure.report.version}</reportVersion>
                    <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
                    <reportDirectory>${project.build.directory}/allure-report</reportDirectory>
                    <!-- allure.config.js at project root: enables all charts + history -->
                    <configPath>${project.basedir}/allure.config.js</configPath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
